{
  "name": "church-management-api",
  "version": "0.13.5",
  "description": "Multi-tenant church management API: membership, secretariat and accounting",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:comments:check": "tsx prisma/tools/check-comments.ts",
    "db:comments:inject": "tsx prisma/tools/inject-comments.ts",
    "db:dictionary": "tsx prisma/tools/data-dictionary.ts",
    "admin:create": "tsx src/cli/create-platform-admin.ts",
    "admin:reset-password": "tsx src/cli/reset-platform-admin-password.ts",
    "docker:up": "docker compose -f ../docker-compose.yml --env-file ../.env up -d",
    "docker:down": "docker compose -f ../docker-compose.yml --env-file ../.env down"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.17.7",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  }
}
