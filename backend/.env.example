# Configuración del backend en local. Copiar a backend/.env.
#
# La API valida estas variables al arrancar (src/config/environment.ts) y no arranca si falta
# una obligatoria o tiene un formato inválido. Usuario, contraseñas, base y puertos deben
# coincidir con el .env de la raíz, que configura los contenedores de MariaDB y Redis.
# En producción estas variables no se leen de un archivo: las define docker-compose.prod.yml.

# ==========================================
# Aplicación
# ==========================================
# Entorno: development, test o production. En production los logs salen en JSON.
NODE_ENV=development
# Puerto HTTP de la API. Todas las rutas cuelgan de /api.
PORT=3000

# ==========================================
# Base de datos (MariaDB)
# ==========================================
# Conexión de la API y de Prisma: mysql://usuario:contraseña@host:puerto/base
# Si la contraseña tiene caracteres como @ : / # deben ir codificados para URL.
DATABASE_URL="mysql://app_user:CHANGE_ME@localhost:3306/church_db"
# Base auxiliar que solo usa `prisma migrate dev` para detectar desviaciones del esquema.
# La crea docker/mariadb/init/01-shadow-database.sh. Prisma la borra y la recrea: nunca debe apuntar a una base con datos.
SHADOW_DATABASE_URL="mysql://app_user:CHANGE_ME@localhost:3306/church_db_shadow"

# ==========================================
# Redis
# ==========================================
# Conexión a Redis: redis://:contraseña@host:puerto (rediss:// si usa TLS).
# La usan la comprobación de salud y el límite de intentos (inicio de sesión y formularios públicos).
REDIS_URL="redis://:CHANGE_ME@localhost:6379"

# ==========================================
# HTTP y seguridad
# ==========================================
# Orígenes del navegador que CORS permite, separados por comas. 4200 es el de `ng serve`.
CORS_ORIGIN="http://localhost:4200"
# Proxies cuyo X-Forwarded-For se acepta para conocer la IP del cliente (los límites de intentos dependen de ella):
# false (sin proxy, en local), un número de saltos (1 detrás de un solo proxy) o direcciones/rangos separados por coma.
# Evita true: confía en todos los saltos y permite que el cliente invente su IP.
TRUST_PROXY=false
# Tamaño máximo del cuerpo de una petición, en bytes (mínimo 1024). 1048576 = 1 MiB.
BODY_LIMIT_BYTES=1048576
# Publica la documentación Swagger en /api/docs. Expone el mapa de la API: en producción, false.
SWAGGER_ENABLED=true

# ==========================================
# Logs
# ==========================================
# Nivel mínimo que se registra: fatal, error, warn, log, debug o verbose.
# Las contraseñas, los tokens y los datos personales se redactan en todos los niveles.
LOG_LEVEL=debug

# ==========================================
# Autenticación
# ==========================================
# Secreto con el que se firman los tokens de acceso. Obligatorio: aleatorio, de al menos 32 caracteres y distinto en cada entorno:
# openssl rand -hex 48
JWT_SECRET=CHANGE_ME
# Vigencia del token de acceso (30s, 15m, 30m). Máximo 30m: corta, porque la sesión se renueva con el refresh token.
JWT_EXPIRATION=15m
# Vigencia del refresh token y de su cookie HttpOnly (ventana deslizante; mismo formato que JWT_EXPIRATION).
REFRESH_TTL=7d
# Duración absoluta de una sesión aunque se rote el refresh token. No puede ser menor que REFRESH_TTL.
REFRESH_MAX_LIFETIME=30d
# Dirección pública de la aplicación web. Con ella se construyen los enlaces de invitación y de recuperación de contraseña.
APP_BASE_URL="http://localhost:4200"

# ==========================================
# Correo (opcional)
# ==========================================
# Sin SMTP_HOST la API no envía correos: lo registra sin destinatario ni enlace y, al invitar a un usuario,
# muestra el enlace de un solo uso a quien invita para que lo envíe por otro medio.
# Con SMTP_HOST, SMTP_FROM es obligatorio; SMTP_USER y SMTP_PASSWORD van juntos o ninguno.
SMTP_HOST=
SMTP_PORT=587
# true para TLS implícito (puerto 465); false negocia STARTTLS si el servidor lo ofrece.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Iglesia 238 <no-reply@example.org>"

# ==========================================
# Primer administrador (solo para npm run admin:create)
# ==========================================
# La API no lee estas variables. Si no se definen, el comando pide el correo y la contraseña (oculta) en la terminal.
# Mejor no dejarlas en el archivo: pásalas solo en la ejecución del comando.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=
