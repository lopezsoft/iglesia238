// ==========================================
// Organización: jerarquía multi-iglesia
// Denominación -> Razón social y Distrito -> Sede o congregación
// Regla: toda tabla de negocio lleva denominationId y sus FK compuestas impiden cruzar denominaciones.
// ==========================================

model Country {
  id      Int      @id @default(autoincrement())
  isoCode String   @unique @map("iso_code") @db.VarChar(3)
  name    String   @unique @db.VarChar(100)
  regions Region[]

  @@map("countries")
}

/// Departamento o estado.
model Region {
  id             Int            @id @default(autoincrement())
  countryId      Int            @map("country_id")
  name           String         @db.VarChar(100)
  country        Country        @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  municipalities Municipality[]

  @@unique([countryId, name])
  @@map("regions")
}

model Municipality {
  id       Int    @id @default(autoincrement())
  regionId Int    @map("region_id")
  name     String @db.VarChar(100)
  region   Region @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  documentIssuedPersons Person[]        @relation("PersonDocumentIssuePlace")
  bornPersons           Person[]        @relation("PersonBirthPlace")
  personAddresses       PersonAddress[]
  neighborhoods         Neighborhood[]
  legalEntities         LegalEntity[]
  congregations         Congregation[]

  @@unique([regionId, name])
  @@map("municipalities")
}

/// Barrio.
model Neighborhood {
  id              Int             @id @default(autoincrement())
  municipalityId  Int             @map("municipality_id")
  name            String          @db.VarChar(120)
  municipality    Municipality    @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  personAddresses PersonAddress[]
  congregations   Congregation[]

  @@unique([municipalityId, name])
  @@map("neighborhoods")
}

/// Denominación: unidad de aislamiento de los datos. La crea un administrador de plataforma.
model Denomination {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique @db.VarChar(200)
  logoPath             String?               @map("logo_path") @db.VarChar(255)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  funds                Fund[]
  accounts             Account[]
  contributionTypes    ContributionType[]
  titheSettlementRules TitheSettlementRule[]
  userRoles            UserRole[]
  pastoralRanks        PastoralRank[]
  studies              Study[]
  churchPositions      ChurchPosition[]
  people               Person[]
  privacyPolicies      PrivacyPolicy[]
  topics               Topic[]
  legalEntities        LegalEntity[]
  districts            District[]
  congregations        Congregation[]
  certificateTypes     CertificateType[]

  @@map("denominations")
}

/// Razón social de una denominación. Una denominación puede tener una o varias.
model LegalEntity {
  id                  Int            @id @default(autoincrement())
  denominationId      Int            @map("denomination_id")
  legalName           String         @map("legal_name") @db.VarChar(200)
  tradeName           String?        @map("trade_name") @db.VarChar(200)
  /// NIT o identificación tributaria.
  taxId               String         @unique @map("tax_id") @db.VarChar(30)
  legalRepresentative String?        @map("legal_representative") @db.VarChar(200)
  email               String?        @db.VarChar(191)
  phone               String?        @db.VarChar(30)
  address             String?        @db.VarChar(200)
  municipalityId      Int?           @map("municipality_id")
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")
  denomination        Denomination   @relation(fields: [denominationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  municipality        Municipality?  @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  congregations       Congregation[]

  @@unique([denominationId, id])
  @@map("legal_entities")
}

model District {
  id             Int            @id @default(autoincrement())
  denominationId Int            @map("denomination_id")
  number         String         @db.VarChar(20)
  name           String?        @db.VarChar(150)
  denomination   Denomination   @relation(fields: [denominationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  congregations  Congregation[]

  @@unique([denominationId, number])
  @@unique([denominationId, id])
  @@map("districts")
}

/// Sede o congregación. Al crearse elige la razón social a la que pertenece.
model Congregation {
  id                  Int       @id @default(autoincrement())
  denominationId      Int       @map("denomination_id")
  legalEntityId       Int       @map("legal_entity_id")
  districtId          Int?      @map("district_id")
  municipalityId      Int?      @map("municipality_id")
  neighborhoodId      Int?      @map("neighborhood_id")
  name                String    @db.VarChar(150)
  address             String?   @db.VarChar(200)
  phone               String?   @db.VarChar(30)
  email               String?   @db.VarChar(191)
  /// Si es falso, la sede no aparece en el formulario público de inscripción.
  acceptsApplications Boolean   @default(true) @map("accepts_applications")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  denomination Denomination  @relation(fields: [denominationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalEntity  LegalEntity   @relation(fields: [denominationId, legalEntityId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  district     District?     @relation(fields: [denominationId, districtId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  outgoingTransfers      MemberTransfer[]        @relation("TransferOrigin")
  incomingTransfers      MemberTransfer[]        @relation("TransferDestination")
  fundOpeningBalances    FundOpeningBalance[]
  accountingPeriods      AccountingPeriod[]
  vouchers               Voucher[]
  vowPledges             VowPledge[]
  contributions          Contribution[]
  titheSettlements       TitheSettlement[]
  budgets                Budget[]
  userRoles              UserRole[]
  members                Member[]
  memberRegistryEntries  MemberRegistryEntry[]
  membershipApplications MembershipApplication[]
  ministries             Ministry[]
  pastoralTerms          PastoralTerm[]
  childDedications       ChildDedication[]
  attendanceSessions     AttendanceSession[]
  documentSequences      DocumentSequence[]
  certificates           Certificate[]

  @@unique([denominationId, name])
  @@unique([denominationId, id])
  @@index([denominationId, acceptsApplications, isActive])
  @@map("congregations")
}
