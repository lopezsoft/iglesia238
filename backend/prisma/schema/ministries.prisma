// ==========================================
// Ficha: ministerios y organización
// HIPÓTESIS: el diccionario solo da los nombres de estas tablas. La jerarquía
// Ministerio > Grupo > Bloque > Equipo debe validarse con el cliente antes de construir sus módulos.
// ==========================================

model Ministry {
  id             Int          @id @default(autoincrement())
  denominationId Int          @map("denomination_id")
  congregationId Int          @map("congregation_id")
  name           String       @db.VarChar(120)
  isActive       Boolean      @default(true) @map("is_active")
  congregation   Congregation @relation(fields: [denominationId, congregationId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  workGroups     WorkGroup[]

  @@unique([congregationId, name])
  @@unique([denominationId, id])
  @@map("ministries")
}

/// Grupo de trabajo.
model WorkGroup {
  id             Int         @id @default(autoincrement())
  denominationId Int         @map("denomination_id")
  ministryId     Int         @map("ministry_id")
  name           String      @db.VarChar(120)
  ministry       Ministry    @relation(fields: [denominationId, ministryId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  workBlocks     WorkBlock[]

  @@unique([ministryId, name])
  @@unique([denominationId, id])
  @@map("work_groups")
}

/// Bloque de trabajo.
model WorkBlock {
  id             Int        @id @default(autoincrement())
  denominationId Int        @map("denomination_id")
  workGroupId    Int        @map("work_group_id")
  name           String     @db.VarChar(120)
  workGroup      WorkGroup  @relation(fields: [denominationId, workGroupId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  workTeams      WorkTeam[]

  @@unique([workGroupId, name])
  @@unique([denominationId, id])
  @@map("work_blocks")
}

/// Equipo de trabajo.
model WorkTeam {
  id              Int              @id @default(autoincrement())
  denominationId  Int              @map("denomination_id")
  workBlockId     Int              @map("work_block_id")
  name            String           @db.VarChar(120)
  workBlock       WorkBlock        @relation(fields: [denominationId, workBlockId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  workTeamMembers WorkTeamMember[]
  schedules       Schedule[]

  @@unique([workBlockId, name])
  @@unique([denominationId, id])
  @@map("work_teams")
}

model WorkTeamMember {
  id             Int       @id @default(autoincrement())
  denominationId Int       @map("denomination_id")
  memberId       Int       @map("member_id")
  workTeamId     Int       @map("work_team_id")
  teamRole       String?   @map("team_role") @db.VarChar(80)
  startedOn      DateTime  @map("started_on") @db.Date
  endedOn        DateTime? @map("ended_on") @db.Date
  member         Member    @relation(fields: [denominationId, memberId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  workTeam       WorkTeam  @relation(fields: [denominationId, workTeamId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([memberId])
  @@index([workTeamId])
  @@map("work_team_members")
}

/// Cronograma.
model Schedule {
  id             Int             @id @default(autoincrement())
  denominationId Int             @map("denomination_id")
  workTeamId     Int             @map("work_team_id")
  name           String          @db.VarChar(120)
  startsOn       DateTime        @map("starts_on") @db.Date
  endsOn         DateTime?       @map("ends_on") @db.Date
  workTeam       WorkTeam        @relation(fields: [denominationId, workTeamId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  scheduleTopics ScheduleTopic[]

  @@unique([denominationId, id])
  @@index([workTeamId])
  @@map("schedules")
}

/// Tema.
model Topic {
  id             Int             @id @default(autoincrement())
  denominationId Int             @map("denomination_id")
  title          String          @db.VarChar(150)
  description    String?         @db.Text
  denomination   Denomination    @relation(fields: [denominationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scheduleTopics ScheduleTopic[]

  @@unique([denominationId, title])
  @@unique([denominationId, id])
  @@map("topics")
}

model ScheduleTopic {
  id             Int      @id @default(autoincrement())
  denominationId Int      @map("denomination_id")
  scheduleId     Int      @map("schedule_id")
  topicId        Int      @map("topic_id")
  scheduledOn    DateTime @map("scheduled_on") @db.Date
  responsibleId  Int?     @map("responsible_id")
  schedule       Schedule @relation(fields: [denominationId, scheduleId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  topic          Topic    @relation(fields: [denominationId, topicId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  responsible    Member?  @relation(fields: [denominationId, responsibleId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([scheduleId, scheduledOn])
  @@map("schedule_topics")
}
