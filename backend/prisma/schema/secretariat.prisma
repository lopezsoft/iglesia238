// ==========================================
// Secretaría: pastores, ceremonias, asistencia, certificados y carnés
// ==========================================

enum MarriageRegistry {
  NOTARY
  CHURCH
}

enum MarriageEndReason {
  DIVORCE
  DEATH
  ANNULMENT
}

/// Periodo de un pastor al frente de una sede, con fecha de inicio y de fin. Ámbito: por sede, dentro de la denominación.
/// Los periodos de una misma sede nunca se solapan (la API lo valida con bloqueo de la sede); el pastor vigente es el del periodo que cubre la fecha actual y solo puede haber un periodo abierto (sin fecha de fin).
model PastoralTerm {
  /// Identificador interno autoincremental.
  id             Int          @id @default(autoincrement())
  /// Denominación dueña del registro; aísla los datos entre iglesias (FK a denominations.id).
  denominationId Int          @map("denomination_id")
  /// Sede a la que pertenece el registro: la sede que el pastor dirige durante el periodo (FK a congregations.id).
  congregationId Int          @map("congregation_id")
  /// Persona que ejerce como pastor de la sede durante el periodo (FK a persons.id).
  pastorId       Int          @map("pastor_id")
  /// Fecha de inicio del periodo pastoral (fecha ISO, sin hora).
  startedOn      DateTime     @map("started_on") @db.Date
  /// Último día del periodo (fecha ISO, inclusiva); nulo si el periodo está abierto, sin cierre definido. No puede ser anterior a started_on; al registrar puede ser futura.
  endedOn        DateTime?    @map("ended_on") @db.Date
  congregation   Congregation @relation(fields: [denominationId, congregationId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  pastor         Person       @relation(fields: [denominationId, pastorId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([congregationId, startedOn])
  @@map("pastoral_terms")
}

/// Matrimonio entre dos personas de la denominación; única fuente de verdad del cónyuge. Ámbito: por denominación, sin sede (una sede ve los de sus miembros).
/// spouse1_id es siempre el menor de los dos (CHECK); nadie tiene dos matrimonios vigentes y la disolución guarda fecha y motivo sin borrar el registro.
model Marriage {
  /// Identificador interno autoincremental.
  id              Int                @id @default(autoincrement())
  /// Denominación dueña del registro; aísla los datos entre iglesias (FK a denominations.id).
  denominationId  Int                @map("denomination_id")
  /// Cónyuge con el id menor de la pareja; el CHECK exige spouse1_id menor que spouse2_id para no duplicar la pareja (FK a persons.id).
  spouse1Id       Int                @map("spouse1_id")
  /// Cónyuge con el id mayor de la pareja (FK a persons.id).
  spouse2Id       Int                @map("spouse2_id")
  /// Indica si hubo rito civil; puede coexistir con los demás ritos. La API lo marca cuando registered_with es NOTARY.
  isCivil         Boolean            @default(false) @map("is_civil")
  /// Indica si hubo rito cristiano; puede coexistir con los demás ritos. La API lo marca cuando registered_with es CHURCH.
  isChristian     Boolean            @default(false) @map("is_christian")
  /// Indica si hubo rito católico, dato de los formularios de la iglesia; la API actual siempre lo registra en falso.
  isCatholic      Boolean            @default(false) @map("is_catholic")
  /// Dónde quedó registrado: NOTARY = notaría (civil), CHURCH = iglesia (cristiano). Si es nulo se deduce de is_civil o is_christian.
  registeredWith  MarriageRegistry?  @map("registered_with")
  /// Fecha de celebración (fecha ISO); no puede ser futura y ambos cónyuges deben ser mayores de edad ese día. Nula si se desconoce.
  marriedOn       DateTime?          @map("married_on") @db.Date
  /// Fecha de disolución (fecha ISO); nula si el matrimonio está vigente. No puede ser futura ni anterior a married_on.
  endedOn         DateTime?          @map("ended_on") @db.Date
  /// Motivo de la disolución: DIVORCE = divorcio, DEATH = fallecimiento de un cónyuge, ANNULMENT = anulación. Nulo si está vigente.
  endReason       MarriageEndReason? @map("end_reason")
  /// Concepto del tribunal eclesiástico sobre el matrimonio. Dato de acceso restringido: la API nunca lo selecciona ni lo expone.
  tribunalOpinion String?            @map("tribunal_opinion") @db.VarChar(255)
  /// Lugar donde se celebró la ceremonia (texto libre, máximo 150 caracteres).
  place           String?            @db.VarChar(150)
  /// Persona que ofició la ceremonia; no puede ser uno de los cónyuges (CHECK). Nulo si no se registró (FK a persons.id).
  officiantId     Int?               @map("officiant_id")
  spouse1         Person             @relation("MarriageSpouse1", fields: [denominationId, spouse1Id], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  spouse2         Person             @relation("MarriageSpouse2", fields: [denominationId, spouse2Id], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  officiant       Person?            @relation("MarriageOfficiant", fields: [denominationId, officiantId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([spouse1Id])
  @@index([spouse2Id])
  @@map("marriages")
}

/// Presentación de un niño o niña ante la iglesia. Ámbito: por sede. Contiene datos de menores: cada consulta individual queda auditada.
/// Un niño tiene una sola presentación; el padre, la madre o el acudiente no se guardan aquí, se vinculan en family_relations.
model ChildDedication {
  /// Identificador interno autoincremental.
  id             Int          @id @default(autoincrement())
  /// Denominación dueña del registro; aísla los datos entre iglesias (FK a denominations.id).
  denominationId Int          @map("denomination_id")
  /// Sede a la que pertenece el registro: donde se hizo la presentación, que debe ser la sede del niño si es miembro (FK a congregations.id).
  congregationId Int          @map("congregation_id")
  /// Niño o niña presentado; la API impide registrar una segunda presentación de la misma persona (FK a persons.id).
  childId        Int          @map("child_id")
  /// Pastor que hizo la presentación; nulo si no se registró (FK a persons.id).
  pastorId       Int?         @map("pastor_id")
  /// Fecha de la presentación (fecha ISO); no puede ser futura ni anterior al nacimiento.
  dedicatedOn    DateTime     @map("dedicated_on") @db.Date
  congregation   Congregation @relation(fields: [denominationId, congregationId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  child          Person       @relation("DedicationChild", fields: [denominationId, childId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  pastor         Person?      @relation("DedicationPastor", fields: [denominationId, pastorId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([congregationId, dedicatedOn])
  @@map("child_dedications")
}

/// Catálogo de tipos de reunión en los que se toma asistencia (Escuela Dominical, culto dominical, reunión de oración, etc.).
/// Ámbito: global, compartido por todas las denominaciones; lo carga el seed.
model MeetingType {
  /// Identificador interno autoincremental.
  id                 Int                 @id @default(autoincrement())
  /// Código estable y único del tipo de reunión (por ejemplo SUNDAY_SCHOOL); la API identifica el tipo por este código.
  code               String              @unique @db.VarChar(30)
  /// Nombre visible del tipo de reunión en español.
  name               String              @db.VarChar(80)
  attendanceSessions AttendanceSession[]

  @@map("meeting_types")
}

/// Catálogo de categorías en que se cuentan los asistentes de una reunión (niños, adolescentes, hermanas, hermanos, visitas).
/// Ámbito: global, compartido por todas las denominaciones; lo carga el seed.
model AttendanceCategory {
  /// Identificador interno autoincremental.
  id               Int               @id @default(autoincrement())
  /// Código estable y único de la categoría (por ejemplo CHILDREN); la API identifica la categoría por este código.
  code             String            @unique @db.VarChar(30)
  /// Nombre visible de la categoría en español.
  name             String            @db.VarChar(80)
  attendanceCounts AttendanceCount[]

  @@map("attendance_categories")
}

/// Registro de asistencia de una reunión: una sola sesión por sede, tipo de reunión y fecha. Ámbito: por sede.
/// El total no se guarda: es la suma de sus conteos por categoría en attendance_counts.
model AttendanceSession {
  /// Identificador interno autoincremental.
  id               Int               @id @default(autoincrement())
  /// Denominación dueña del registro; aísla los datos entre iglesias (FK a denominations.id).
  denominationId   Int               @map("denomination_id")
  /// Sede a la que pertenece el registro: donde se realizó la reunión (FK a congregations.id).
  congregationId   Int               @map("congregation_id")
  /// Tipo de reunión a la que corresponde la sesión (FK a meeting_types.id).
  meetingTypeId    Int               @map("meeting_type_id")
  /// Fecha en que se realizó la reunión (fecha ISO); no puede ser futura según la hora de Bogotá.
  sessionDate      DateTime          @map("session_date") @db.Date
  /// Usuario que registró la sesión o hizo la última corrección de sus conteos; nulo si no se conoce (FK a users.id).
  recordedById     Int?              @map("recorded_by_id")
  /// Fecha y hora del registro o de la última corrección de los conteos (UTC).
  recordedAt       DateTime          @default(now()) @map("recorded_at")
  congregation     Congregation      @relation(fields: [denominationId, congregationId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  meetingType      MeetingType       @relation(fields: [meetingTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy       User?             @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attendanceCounts AttendanceCount[]

  @@unique([congregationId, meetingTypeId, sessionDate])
  @@map("attendance_sessions")
}

/// Cantidad de asistentes de una categoría en una sesión de asistencia; clave primaria sesión más categoría. Ámbito: por sede, heredado de la sesión.
/// Se guarda una fila por cada categoría del catálogo (0 si nadie asistió); corregir la sesión reemplaza todas sus filas.
model AttendanceCount {
  /// Sesión de asistencia a la que pertenece el conteo (FK a attendance_sessions.id).
  sessionId  Int                @map("session_id")
  /// Categoría de asistentes contada (FK a attendance_categories.id).
  categoryId Int                @map("category_id")
  /// Número de asistentes de la categoría: entero de 0 a 2000 (el CHECK exige no negativo; el tope lo valida la API).
  headcount  Int
  session    AttendanceSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category   AttendanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([sessionId, categoryId])
  @@map("attendance_counts")
}

/// Tipo de certificado que una denominación puede expedir. Ámbito: por denominación.
/// Al crear la denominación se cargan MEM (membresía), TRA (traslado), BAU (bautismo) y ASI (asistencia); cada tipo lleva su propio consecutivo por sede.
model CertificateType {
  /// Identificador interno autoincremental.
  id                     Int           @id @default(autoincrement())
  /// Denominación dueña del registro; aísla los datos entre iglesias (FK a denominations.id).
  denominationId         Int           @map("denomination_id")
  /// Código corto del tipo, único por denominación (A-Z, 0-9 y guion bajo); forma la clave del consecutivo y el número impreso, como en CERT-MEM-2026-0031.
  code                   String        @db.VarChar(30)
  /// Nombre visible del tipo de certificado, por ejemplo Certificado de membresía.
  name                   String        @db.VarChar(100)
  /// Cuerpo personalizado con marcadores {{memberName}}, {{document}}, {{memberCode}}, {{congregation}}, {{sede}}, {{joinedOn}}, {{baptismDate}}, {{denomination}}, {{city}}, {{issuedOn}}, {{pastorName}}, {{secretaryName}}, {{fiscalYear}}, {{periodFrom}}, {{periodTo}}, {{totalAmount}}, {{totalInWords}} (los cinco últimos solo en el certificado de donaciones, código DON); nulo usa el texto por defecto.
  template               String?       @db.Text
  /// Encabezado del cuerpo con los mismos marcadores que template (máximo 500 caracteres); nulo usa «La Secretaría de {{sede}} hace constar».
  introTemplate          String?       @map("intro_template") @db.VarChar(500)
  /// Párrafo de cierre con los mismos marcadores que template (máximo 500 caracteres); nulo usa «Se expide en {{city}}, el {{issuedOn}}, a solicitud del interesado(a).».
  closingTemplate        String?       @map("closing_template") @db.VarChar(500)
  /// Título impreso bajo la firma del pastor, con los mismos marcadores que template (máximo 120 caracteres); nulo usa «Pastor(a), {{congregation}}».
  pastorTitleTemplate    String?       @map("pastor_title_template") @db.VarChar(120)
  /// Título impreso bajo la firma de la secretaría, con los mismos marcadores que template (máximo 120 caracteres); nulo usa «Secretario(a), {{congregation}}».
  secretaryTitleTemplate String?       @map("secretary_title_template") @db.VarChar(120)
  /// Días de vigencia del certificado contados desde su expedición; nulo si el certificado no vence.
  validityDays           Int?          @map("validity_days")
  denomination           Denomination  @relation(fields: [denominationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  certificates           Certificate[]

  @@unique([denominationId, code])
  @@unique([denominationId, id])
  @@map("certificate_types")
}

/// Contador de numeración consecutiva por sede y clave: números de miembro, comprobantes y certificados. Ámbito: por sede.
/// Se incrementa dentro de la transacción que guarda el documento, así que no deja huecos ni colisiones; nunca se reinicia (el año solo es formato).
model DocumentSequence {
  /// Denominación dueña del registro; aísla los datos entre iglesias (FK a denominations.id).
  denominationId Int          @map("denomination_id")
  /// Sede a la que pertenece el registro: la sede dueña del contador (FK a congregations.id).
  congregationId Int          @map("congregation_id")
  /// Clave del contador (máximo 60): MEMBER = número de miembro, VOUCHER:«tipo» = comprobantes, CERT:«código» = certificados por tipo.
  key            String       @db.VarChar(60)
  /// Último número asignado con esta clave; el siguiente documento recibe este valor más uno. Empieza en 0.
  lastValue      Int          @default(0) @map("last_value")
  congregation   Congregation @relation(fields: [denominationId, congregationId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([congregationId, key])
  @@map("document_sequences")
}

/// Certificado expedido a un miembro, con número consecutivo por sede y tipo. Ámbito: por sede; se expide en la sede actual del miembro (lo valida la API).
/// snapshot conserva lo impreso, así que el documento no cambia si cambian los datos; los certificados se anulan, nunca se borran.
model Certificate {
  /// Identificador interno autoincremental.
  id                Int       @id @default(autoincrement())
  /// Denominación dueña del registro; aísla los datos entre iglesias (FK a denominations.id).
  denominationId    Int       @map("denomination_id")
  /// Sede a la que pertenece el registro: la sede que expide el certificado (FK a congregations.id).
  congregationId    Int       @map("congregation_id")
  /// Tipo de certificado expedido (FK a certificate_types.id).
  certificateTypeId Int       @map("certificate_type_id")
  /// Miembro al que se le expide el certificado (FK a members.id).
  memberId          Int       @map("member_id")
  /// Consecutivo sin huecos por sede y tipo, tomado de document_sequences; se imprime como CERT-«código»-«año»-0000.
  sequenceNumber    Int       @map("sequence_number")
  /// Fecha de expedición (fecha ISO): el día de la emisión según la hora de Bogotá; su año aparece en el número impreso.
  issuedOn          DateTime  @map("issued_on") @db.Date
  /// Fecha de vencimiento (fecha ISO): issued_on más validity_days del tipo; nula si el tipo no vence.
  expiresOn         DateTime? @map("expires_on") @db.Date
  /// Texto de destino o trámite para el que se expide el certificado («válido para»); la API actual no lo diligencia y queda nulo.
  validFor          String?   @map("valid_for") @db.VarChar(150)
  /// Observaciones opcionales que se imprimen en el certificado (máximo 255 caracteres).
  notes             String?   @db.VarChar(255)
  /// Pastor que firma el certificado; es obligatorio para expedirlo (FK a persons.id).
  pastorSignerId    Int       @map("pastor_signer_id")
  /// Firmante por la secretaría (rol SECRETARY de la sede, de preferencia quien expide); nulo si no hay firma o el firmante no tiene persona vinculada (nombre solo en snapshot) (FK a persons.id).
  secretarySignerId Int?      @map("secretary_signer_id")
  /// Usuario del sistema que expidió el certificado; nulo si no hay usuario asociado (FK a users.id).
  issuedById        Int?      @map("issued_by_id")
  /// Copia JSON de lo impreso: número, título, membrete, textos, firmantes y datos del miembro; no se modifica después de expedido.
  snapshot          Json
  /// Fecha y hora de anulación (UTC); nula si el certificado está vigente.
  voidedAt          DateTime? @map("voided_at")
  /// Motivo de la anulación (10 a 255 caracteres, obligatorio al anular en la API); solo puede tener valor si voided_at lo tiene (CHECK).
  voidReason        String?   @map("void_reason") @db.VarChar(255)
  /// Fecha y hora de creación del registro (UTC).
  createdAt         DateTime  @default(now()) @map("created_at")

  congregation    Congregation     @relation(fields: [denominationId, congregationId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  certificateType CertificateType  @relation(fields: [denominationId, certificateTypeId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  member          Member           @relation(fields: [denominationId, memberId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  pastorSigner    Person           @relation("CertificatePastorSigner", fields: [denominationId, pastorSignerId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  secretarySigner Person?          @relation("CertificateSecretarySigner", fields: [denominationId, secretarySignerId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy        User?            @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberTransfers MemberTransfer[]

  @@unique([congregationId, certificateTypeId, sequenceNumber])
  @@unique([denominationId, id])
  @@index([memberId])
  @@index([congregationId, issuedOn])
  @@map("certificates")
}

/// Carné de membresía emitido por una sede, con fechas de emisión y vencimiento. Ámbito: por sede.
/// Un miembro tiene a lo sumo un carné válido por sede; al emitir uno nuevo se anulan los válidos de sedes anteriores. Los carnés se anulan, nunca se borran.
model MembershipCard {
  /// Identificador interno autoincremental.
  id             Int          @id @default(autoincrement())
  /// Denominación dueña del registro; aísla los datos entre iglesias (FK a denominations.id).
  denominationId Int          @map("denomination_id")
  /// Miembro titular del carné (FK a members.id).
  memberId       Int          @map("member_id")
  /// Sede a la que pertenece el registro: la que emitió el carné; se conserva aunque el miembro se traslade (FK a congregations.id).
  congregationId Int          @map("congregation_id")
  /// Número del miembro en el registro de la sede emisora (consecutivo MEMBER); se imprime como «código de sede»-0000, por ejemplo SC-0153, y se conserva tras un traslado.
  memberNumber   Int          @map("member_number")
  /// Fecha de emisión del carné (fecha ISO); no puede ser futura.
  issuedOn       DateTime     @map("issued_on") @db.Date
  /// Fecha de vencimiento (fecha ISO), posterior a issued_on; el carné es válido si no está anulado y esta fecha no ha pasado.
  expiresOn      DateTime     @map("expires_on") @db.Date
  /// Fecha y hora de anulación (UTC); nula si el carné no se ha anulado.
  voidedAt       DateTime?    @map("voided_at")
  /// Motivo de la anulación (máximo 255); existe si y solo si voided_at tiene valor (CHECK). Si lo reemplaza un carné nuevo, el motivo es automático.
  voidReason     String?      @map("void_reason") @db.VarChar(255)
  member         Member       @relation(fields: [denominationId, memberId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)
  congregation   Congregation @relation(fields: [denominationId, congregationId], references: [denominationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([memberId])
  @@map("membership_cards")
}
