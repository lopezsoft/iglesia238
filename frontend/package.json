{
  "name": "frontend",
  "version": "0.14.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4700 --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
