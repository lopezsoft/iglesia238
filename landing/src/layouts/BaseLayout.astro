---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Iglesia 238 — El sistema que impulsa el crecimiento y orden de tu iglesia',
  description = 'Integra tu membresía oficial (F-701), secretaría, certificados en PDF, asistencia, diezmos, votos y libro de caja por sede y denominación en un solo lugar.',
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2a5ee8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://iglesia238.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('ig238-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Botón flotante de acceso rápido / soporte (estilo matias.com.co / maticerts.com) -->
    <a
      href="https://app.iglesia238.com/apply/status"
      data-app-path="/apply/status"
      class="floating-support"
      aria-label="Consultar estado de solicitud F-701"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      <span class="floating-support__tooltip">Consultar solicitud F-701</span>
    </a>

    <script is:inline>
      (function () {
        const host = window.location.hostname;
        const isLocal = host === 'localhost' || host === '127.0.0.1';
        const appBase = isLocal ? 'http://localhost:4700' : 'https://app.iglesia238.com';

        document.querySelectorAll('[data-app-path]').forEach((el) => {
          const path = el.getAttribute('data-app-path');
          if (path) {
            el.setAttribute('href', appBase + path);
          }
        });
      })();
    </script>

    <style>
      .floating-support {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 90;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #22c55e;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 26px rgba(34, 197, 94, 0.38);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .floating-support:hover {
        transform: scale(1.06) translateY(-2px);
        box-shadow: 0 14px 32px rgba(34, 197, 94, 0.5);
      }

      .floating-support__tooltip {
        position: absolute;
        left: 62px;
        background: var(--text-navy);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transform: translateX(-6px);
        transition: all 0.18s ease;
      }

      .floating-support:hover .floating-support__tooltip {
        opacity: 1;
        transform: translateX(0);
      }
    </style>
  </body>
</html>
