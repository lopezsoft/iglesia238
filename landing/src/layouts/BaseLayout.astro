---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  includeFaqSchema?: boolean;
}

const {
  title = 'Iglesia 238 — Software de Gestión Eclesiástica, Membresía F-701 y Contabilidad',
  description = 'Plataforma multi-iglesia y multi-sede para administrar membresía oficial (F-701), secretaría, certificados en PDF, asistencia, diezmos, votos y libro de caja sin trámites en papel.',
  keywords = 'software para iglesias, gestión eclesiástica, membresía de iglesia F-701, contabilidad para iglesias, libro de caja iglesia, certificados de bautismo en PDF, liquidación de diezmos, administración pastoral multi-sede, software congregaciones Colombia Latinoamérica',
  ogImage = 'https://iglesia238.com/brand/png/iglesia238-logo-horizontal-1024.png',
  includeFaqSchema = false,
} = Astro.props;

const siteUrl = 'https://iglesia238.com';
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, siteUrl).toString();

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Inicio',
    item: `${siteUrl}/`,
  },
];

if (pathname !== '/') {
  const cleanName =
    pathname.includes('soluciones')
      ? 'Soluciones por Ministerio'
      : pathname.includes('como-funciona')
        ? 'Cómo funciona'
        : pathname.includes('seguridad')
          ? 'Seguridad y Ley 1581'
          : pathname.includes('docs/manual-roles')
            ? 'Manual Operativo por Rol'
            : pathname.includes('docs/auto-alojamiento')
              ? 'Guía de Auto-Alojamiento (Docker / Dokploy)'
              : pathname.includes('docs')
                ? 'Documentación y Manuales'
                : 'Página';
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: cleanName,
    item: canonicalUrl,
  });
}

const schemaGraph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'Iglesia 238',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/brand/png/iglesia238-isotipo-a-512.png`,
      width: 512,
      height: 512,
    },
    sameAs: ['https://app.iglesia238.com', 'https://github.com/lopezsoft/iglesia238'],
  },
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: siteUrl,
    name: 'Iglesia 238',
    inLanguage: 'es-CO',
    publisher: {
      '@id': `${siteUrl}/#organization`,
    },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${siteUrl}/#software`,
    name: 'Iglesia 238',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Windows, macOS, Android, iOS',
    url: 'https://app.iglesia238.com',
    description,
    featureList: [
      'Formulario público de membresía oficial F-701',
      'Expediente 360° del miembro, familia, matrimonio y estudios',
      'Emisión de certificados de bautismo y membresía en PDF',
      'Recibos consecutivos REC, promesas de voto y abonos',
      'Libro de caja mensual por fondos y liquidación de diezmos',
      'Aislamiento multi-sede y cumplimiento de Ley 1581 de 2012 (Habeas Data)',
    ],
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'COP',
      description: 'Registro y activación inmediata de sedes en línea',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  },
];

if (includeFaqSchema) {
  schemaGraph.push({
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '¿Cómo registro una sede nueva de mi iglesia en la plataforma?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Ingresa a Registrar mi sede en app.iglesia238.com/register-congregation, elige la razón social activa de tu denominación, selecciona el departamento y municipio de la sede y registra tus datos de administrador. Al confirmar el enlace enviado a tu correo, quedas habilitado con los roles de Pastor, Secretaría y Tesorería de tu sede.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Por qué un miembro que llena el formulario público F-701 no aparece de inmediato en el listado oficial?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Para resguardar el libro oficial de membresía, toda solicitud enviada en /apply ingresa primero a la bandeja de Solicitudes de membresía en estado Pendiente. Cuando el Pastor o la Secretaría la revisa y aprueba, el sistema crea su ficha, registra su familia y matrimonio, y le asigna su número consecutivo de miembro.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Puedo editar el lugar de nacimiento, expedición, matrimonio, familiares y estudios de un miembro?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Sí. Desde la ficha del miembro (/members/:id) puedes actualizar sus municipios con selectores por departamento, estado civil, datos del cónyuge y tipo de matrimonio (civil, cristiano, católico), registrar o editar familiares directamente en la pestaña Familia y actualizar sus estudios.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Cómo se protege la información entre distintas sedes o denominaciones?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Cada consulta valida el alcance activo (X-Scope) contra los roles vigentes del usuario en tiempo real. Un usuario con alcance de sede solo puede operar dentro de su congregación, y todas las tablas de negocio tienen llaves compuestas por denominación en la base de datos.',
        },
      },
    ],
  });
}

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
});
---

<!doctype html>
<html lang="es-CO" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Lopezsoft · Iglesia 238" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#2a5ee8" />

    <!-- Canonical & Hreflang SEO -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-CO" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-419" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Favicons & Apple Touch Icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Iglesia 238" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Iglesia 238 — Plataforma de Gestión Eclesiástica, Membresía F-701 y Contabilidad" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados JSON-LD (Schema.org: Organization + WebSite + SoftwareApplication + BreadcrumbList + FAQPage) -->
    <script type="application/ld+json" set:html={jsonLd} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('ig238-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Botón flotante de acceso rápido / soporte (estilo matias.com.co / maticerts.com) -->
    <a
      href="https://app.iglesia238.com/apply/status"
      data-app-path="/apply/status"
      class="floating-support"
      aria-label="Consultar estado de solicitud F-701"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      <span class="floating-support__tooltip">Consultar solicitud F-701</span>
    </a>

    <script is:inline>
      (function () {
        const host = window.location.hostname;
        const isLocal = host === 'localhost' || host === '127.0.0.1';
        const appBase = isLocal ? 'http://localhost:4700' : 'https://app.iglesia238.com';

        document.querySelectorAll('[data-app-path]').forEach((el) => {
          const path = el.getAttribute('data-app-path');
          if (path) {
            el.setAttribute('href', appBase + path);
          }
        });
      })();
    </script>

    <style>
      .floating-support {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 90;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #22c55e;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 26px rgba(34, 197, 94, 0.38);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .floating-support:hover {
        transform: scale(1.06) translateY(-2px);
        box-shadow: 0 14px 32px rgba(34, 197, 94, 0.5);
      }

      .floating-support__tooltip {
        position: absolute;
        left: 62px;
        background: var(--text-navy);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transform: translateX(-6px);
        transition: all 0.18s ease;
      }

      .floating-support:hover .floating-support__tooltip {
        opacity: 1;
        transform: translateX(0);
      }
    </style>
  </body>
</html>
