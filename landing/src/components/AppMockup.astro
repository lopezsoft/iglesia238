---
---

<div class="mockup-stage">
  <!-- Tarjeta flotante 1 (Arriba centro-derecha: Certificados y Carnés PDF) -->
  <div class="float-badge float-badge--ai">
    <div class="float-badge__icon float-badge__icon--purple">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
        <circle cx="12" cy="8" r="6"></circle>
        <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
      </svg>
    </div>
    <div class="float-badge__body">
      <div class="float-badge__row">
        <span class="float-badge__title">Certificados y Carnés</span>
        <span class="float-badge__tag float-badge__tag--purple">PDF</span>
      </div>
      <div class="float-badge__sub">Bautismo y membresía con consecutivo</div>
    </div>
  </div>

  <!-- Tarjeta flotante 2 (Izquierda superior: Solicitud F-701 validada) -->
  <div class="float-badge float-badge--f701">
    <div class="float-badge__icon float-badge__icon--emerald">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
    </div>
    <div class="float-badge__body">
      <div class="float-badge__row">
        <span class="float-badge__title">Ficha F-701 electrónica</span>
        <span class="float-badge__tag float-badge__tag--emerald">0.3s</span>
      </div>
      <div class="float-badge__sub">Aprobada en el libro de membresía</div>
    </div>
  </div>

  <!-- Tarjeta flotante 3 (Derecha media: Recibo REC En vivo) -->
  <div class="float-badge float-badge--pos">
    <div class="float-badge__icon float-badge__icon--blue">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
      </svg>
    </div>
    <div class="float-badge__body">
      <div class="float-badge__row">
        <span class="float-badge__title">Recibo REC y Caja</span>
        <span class="float-badge__tag float-badge__tag--blue">En vivo</span>
      </div>
      <div class="float-badge__sub">Registrado y emitido en PDF</div>
    </div>
  </div>

  <!-- Tarjeta flotante 4 (Abajo izquierda: Liquidación de diezmos Nube) -->
  <div class="float-badge float-badge--bottom">
    <div class="float-badge__icon float-badge__icon--violet">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
      </svg>
    </div>
    <div class="float-badge__body">
      <div class="float-badge__row">
        <span class="float-badge__title">Liquidación de diezmos</span>
        <span class="float-badge__tag float-badge__tag--purple">Nube</span>
      </div>
      <div class="float-badge__sub">Consolidada por sede y distrito</div>
    </div>
  </div>

  <!-- Ventana de navegador principal réplica de app.iglesia238.com -->
  <div class="app-window">
    <div class="app-window__chrome">
      <div class="window-dots">
        <span></span><span></span><span></span>
      </div>
      <div class="window-address">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>app.iglesia238.com</span>
      </div>
      <div class="window-uptime">
        <span class="uptime-dot"></span> Online 99.9%
      </div>
    </div>

    <div class="app-window__workspace">
      <!-- Barra lateral azul oscuro de Iglesia 238 -->
      <aside class="mini-sidebar">
        <div class="mini-sidebar__brand">
          <img src="/brand/isotipo-a-sede.svg" alt="" width="20" height="20" />
          <span>IGLESIA 238</span>
        </div>
        <ul class="mini-sidebar__menu">
          <li class="active"><span>▣</span> Inicio</li>
          <li><span>🏢</span> Sedes</li>
          <li><span>🪪</span> Solicitudes</li>
          <li><span>👥</span> Miembros</li>
          <li><span>📜</span> Certific.</li>
          <li><span>📅</span> Asistencia</li>
          <li><span>📖</span> Registros</li>
          <li><span>🧾</span> Aportes</li>
          <li><span>🤝</span> Votos</li>
          <li><span>📒</span> Caja</li>
          <li><span>⚖️</span> Diezmo</li>
          <li><span>📊</span> Reportes</li>
        </ul>
      </aside>

      <!-- Área principal del Dashboard -->
      <div class="mini-main">
        <div class="mini-topbar">
          <div class="mini-scope">
            <span class="mini-scope__dot"></span>
            <span>Sede Central · C:101</span>
          </div>
          <div class="mini-user">
            <div class="mini-user__meta">
              <strong>Pastor Luis Rojas</strong>
              <span>Alcance: Sede Central</span>
            </div>
            <div class="mini-user__avatar">LR</div>
          </div>
        </div>

        <!-- Cuadrícula 4x2 de 8 tarjetas KPI (idéntico al layout de matias.com.co) -->
        <div class="mini-kpi-grid">
          <div class="mini-kpi">
            <span class="mini-kpi__icon mini-kpi__icon--blue">👥</span>
            <strong class="mini-kpi__val">428</strong>
            <span class="mini-kpi__lbl">Miembros activos</span>
            <small class="mini-kpi__sub">+14 este mes</small>
          </div>
          <div class="mini-kpi">
            <span class="mini-kpi__icon mini-kpi__icon--emerald">🪪</span>
            <strong class="mini-kpi__val">12</strong>
            <span class="mini-kpi__lbl">Solicitudes F-701</span>
            <small class="mini-kpi__sub">En revisión</small>
          </div>
          <div class="mini-kpi">
            <span class="mini-kpi__icon mini-kpi__icon--purple">📜</span>
            <strong class="mini-kpi__val">96</strong>
            <span class="mini-kpi__lbl">Certificados PDF</span>
            <small class="mini-kpi__sub">Emitidos 2026</small>
          </div>
          <div class="mini-kpi">
            <span class="mini-kpi__icon mini-kpi__icon--amber">📅</span>
            <strong class="mini-kpi__val">385</strong>
            <span class="mini-kpi__lbl">Asistencia culto</span>
            <small class="mini-kpi__sub">+9,2 % dominical</small>
          </div>
          <div class="mini-kpi">
            <span class="mini-kpi__icon mini-kpi__icon--emerald">$</span>
            <strong class="mini-kpi__val">$18,4M</strong>
            <span class="mini-kpi__lbl">Aportes del mes</span>
            <small class="mini-kpi__sub">162 recibos REC</small>
          </div>
          <div class="mini-kpi">
            <span class="mini-kpi__icon mini-kpi__icon--blue">📒</span>
            <strong class="mini-kpi__val">$14,9M</strong>
            <span class="mini-kpi__lbl">Saldo en caja</span>
            <small class="mini-kpi__sub">Fondo general</small>
          </div>
          <div class="mini-kpi">
            <span class="mini-kpi__icon mini-kpi__icon--purple">🤝</span>
            <strong class="mini-kpi__val">86 %</strong>
            <span class="mini-kpi__lbl">Votos cumplidos</span>
            <small class="mini-kpi__sub">24 promesas activas</small>
          </div>
          <div class="mini-kpi">
            <span class="mini-kpi__icon mini-kpi__icon--amber">⚖️</span>
            <strong class="mini-kpi__val">Al día</strong>
            <span class="mini-kpi__lbl">Liquidación diezmo</span>
            <small class="mini-kpi__sub">Periodo abierto</small>
          </div>
        </div>

        <!-- Fila inferior de 2 gráficos (Barras verticales + Barras horizontales) -->
        <div class="mini-charts-row">
          <div class="mini-chart-card">
            <div class="mini-chart-card__head">
              <span>Crecimiento de membresía y asistencia</span>
              <strong>+18,4 %</strong>
            </div>
            <div class="mini-vbars">
              <span style="height: 36%"></span>
              <span style="height: 48%"></span>
              <span style="height: 44%"></span>
              <span style="height: 62%"></span>
              <span style="height: 58%"></span>
              <span style="height: 75%"></span>
              <span style="height: 84%"></span>
              <span class="highlight" style="height: 96%"></span>
            </div>
          </div>

          <div class="mini-chart-card">
            <div class="mini-chart-card__head">
              <span>Ejecución por fondos de la sede</span>
              <strong>2026</strong>
            </div>
            <div class="mini-hbars">
              <div class="mini-hbar">
                <span>Fondo General</span>
                <div class="mini-hbar__track"><div style="width: 88%"></div></div>
              </div>
              <div class="mini-hbar">
                <span>Misiones y Obra Social</span>
                <div class="mini-hbar__track"><div style="width: 72%"></div></div>
              </div>
              <div class="mini-hbar">
                <span>Construcción Templo</span>
                <div class="mini-hbar__track"><div style="width: 64%"></div></div>
              </div>
              <div class="mini-hbar">
                <span>Educación Cristiana</span>
                <div class="mini-hbar__track"><div style="width: 91%"></div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .mockup-stage {
    position: relative;
    padding: 1.8rem 1.2rem 2rem;
  }

  .app-window {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .app-window__chrome {
    height: 40px;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .window-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .window-dots span:nth-child(1) {
    background: #f87171;
  }
  .window-dots span:nth-child(2) {
    background: #fbbf24;
  }
  .window-dots span:nth-child(3) {
    background: #34d399;
  }

  .window-address {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.18rem 0.85rem;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .window-uptime {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-navy);
  }

  .uptime-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .app-window__workspace {
    display: grid;
    grid-template-columns: 122px 1fr;
    min-height: 365px;
  }

  .mini-sidebar {
    background: linear-gradient(180deg, #16377b 0%, #0e2352 100%);
    color: rgba(255, 255, 255, 0.78);
    padding: 0.85rem 0.65rem;
  }

  .mini-sidebar__brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffffff;
    padding-bottom: 0.65rem;
    margin-bottom: 0.55rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .mini-sidebar__menu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mini-sidebar__menu li {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.32rem 0.45rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .mini-sidebar__menu li.active {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
  }

  .mini-main {
    padding: 0.8rem 0.95rem 0.95rem;
    background: var(--bg-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mini-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.42rem 0.7rem;
  }

  .mini-scope {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-navy);
  }

  .mini-scope__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
  }

  .mini-user {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .mini-user__meta {
    display: flex;
    flex-direction: column;
    text-align: right;
    line-height: 1.15;
  }

  .mini-user__meta strong {
    font-size: 0.64rem;
    color: var(--text-navy);
  }

  .mini-user__meta span {
    font-size: 0.56rem;
    color: var(--text-muted);
  }

  .mini-user__avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--primary);
    color: #ffffff;
    font-size: 0.6rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mini-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .mini-kpi {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.52rem 0.55rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: var(--shadow-xs);
  }

  .mini-kpi__icon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 800;
    margin-bottom: 0.22rem;
  }

  .mini-kpi__icon--blue {
    background: var(--primary-soft);
    color: var(--primary);
  }
  .mini-kpi__icon--emerald {
    background: var(--emerald-soft);
    color: var(--emerald);
  }
  .mini-kpi__icon--purple {
    background: var(--purple-soft);
    color: var(--purple);
  }
  .mini-kpi__icon--amber {
    background: var(--amber-soft);
    color: var(--amber);
  }

  .mini-kpi__val {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-navy);
    line-height: 1.15;
  }

  .mini-kpi__lbl {
    font-size: 0.58rem;
    font-weight: 600;
    color: var(--text-body);
  }

  .mini-kpi__sub {
    font-size: 0.52rem;
    color: var(--text-muted);
  }

  .mini-charts-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }

  .mini-chart-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.6rem 0.7rem;
  }

  .mini-chart-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6rem;
    color: var(--text-muted);
    margin-bottom: 0.45rem;
  }

  .mini-chart-card__head strong {
    color: var(--emerald);
    font-weight: 800;
  }

  .mini-vbars {
    height: 68px;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    align-items: end;
    gap: 5px;
    padding-top: 6px;
  }

  .mini-vbars span {
    display: block;
    width: 100%;
    border-radius: 4px 4px 1px 1px;
    background: #93c5fd;
  }

  .mini-vbars span.highlight {
    background: var(--primary);
  }

  .mini-hbars {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mini-hbar span {
    display: block;
    font-size: 0.55rem;
    font-weight: 600;
    color: var(--text-body);
    margin-bottom: 2px;
  }

  .mini-hbar__track {
    height: 6px;
    background: var(--bg-muted);
    border-radius: 99px;
    overflow: hidden;
  }

  .mini-hbar__track div {
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--primary) 0%, #60a5fa 100%);
  }

  /* Floating notification badges (matias.com.co style) */
  .float-badge {
    position: absolute;
    z-index: 4;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.68rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.68rem;
    box-shadow: 0 16px 38px rgba(11, 21, 40, 0.13);
    animation: floatPulse 5s ease-in-out infinite;
  }

  .float-badge--ai {
    top: -4px;
    right: 68px;
  }

  .float-badge--f701 {
    top: 76px;
    left: -18px;
    animation-delay: 1.2s;
  }

  .float-badge--pos {
    bottom: 92px;
    right: -14px;
    animation-delay: 2.1s;
  }

  .float-badge--bottom {
    bottom: -4px;
    left: 48px;
    animation-delay: 0.7s;
  }

  @keyframes floatPulse {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  .float-badge__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
  }

  .float-badge__icon--purple {
    background: linear-gradient(135deg, #c084fc 0%, #9333ea 100%);
  }
  .float-badge__icon--emerald {
    background: linear-gradient(135deg, #34d399 0%, #059669 100%);
  }
  .float-badge__icon--blue {
    background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
  }
  .float-badge__icon--violet {
    background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
  }

  .float-badge__row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.1rem;
  }

  .float-badge__title {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--text-navy);
  }

  .float-badge__tag {
    font-size: 0.64rem;
    font-weight: 800;
    padding: 0.1rem 0.42rem;
    border-radius: 99px;
  }

  .float-badge__tag--purple {
    background: var(--purple-soft);
    color: var(--purple);
  }
  .float-badge__tag--emerald {
    background: var(--emerald-soft);
    color: #059669;
  }
  .float-badge__tag--blue {
    background: var(--primary-soft);
    color: var(--primary);
  }

  .float-badge__sub {
    font-size: 0.68rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .app-window__workspace {
      grid-template-columns: 1fr;
    }
    .mini-sidebar {
      display: none;
    }
    .mini-kpi-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .float-badge {
      position: static;
      margin-bottom: 0.6rem;
      animation: none;
    }
  }
</style>
