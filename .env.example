# Variables de Entorno - Docker Compose

# ==========================================
# MariaDB Configuration
# ==========================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=fullstack_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

# ==========================================
# JWT Configuration
# ==========================================
