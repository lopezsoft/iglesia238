# Variables de Docker Compose. Copiar a .env (desarrollo, docker-compose.yml)
# o a .env.production (producción, docker-compose.prod.yml).
#
# Los secretos no tienen valor por defecto: Compose se niega a arrancar si faltan.
# Usar contraseñas hexadecimales largas, que no hay que codificar en URL: openssl rand -hex 32
# MariaDB solo aplica base, usuario y contraseñas al crear el volumen por primera vez:
# para cambiarlos después, recrear el volumen (docker compose down -v) o cambiarlos con SQL.

# ==========================================
# MariaDB
# ==========================================
# Contraseña del usuario root. Solo para administración manual; la API nunca la usa.
MYSQL_ROOT_PASSWORD=
# Base de datos de la aplicación. En desarrollo se crea además <base>_shadow para `prisma migrate dev`.
MYSQL_DATABASE=church_db
# Usuario dueño del esquema. En desarrollo lo usan la API y Prisma (debe coincidir con backend/.env).
# En producción solo lo usa el migrador; la API se conecta con APP_DB_USER.
MYSQL_USER=app_user
# Contraseña de MYSQL_USER.
MYSQL_PASSWORD=

# ==========================================
# Redis
# ==========================================
# Contraseña de Redis (requirepass). En desarrollo debe coincidir con REDIS_URL en backend/.env.
REDIS_PASSWORD=

# ==========================================
# Puertos publicados en el equipo (solo desarrollo, siempre en 127.0.0.1)
# ==========================================
# Puerto de MariaDB. Cambiarlo si está ocupado (WAMP usa 3306 y 3307) y ajustar backend/.env.
DB_PORT=3306
# Puerto de Redis. Cambiarlo si está ocupado y ajustar REDIS_URL en backend/.env.
REDIS_PORT=6379

# ==========================================
# Solo producción
# ==========================================
# Usuario con el que se conecta la API: solo SELECT, INSERT, UPDATE y DELETE (docker/mariadb/init-prod).
APP_DB_USER=api_user
# Contraseña de APP_DB_USER.
APP_DB_PASSWORD=
# Orígenes del navegador que CORS permite, separados por comas. Obligatorio.
CORS_ORIGIN=https://app.iglesia238.com,https://iglesia238.com
# Publica Swagger en /api/docs. Expone el mapa de la API: mantener en false salvo necesidad puntual.
SWAGGER_ENABLED=false
# Tamaño máximo del cuerpo de una petición, en bytes (mínimo 1024). 1048576 = 1 MiB.
BODY_LIMIT_BYTES=1048576
# Puerto del equipo donde se publica la API (solo 127.0.0.1).
BACKEND_PORT=3000
# Puerto del equipo donde se publica el frontend.
FRONTEND_PORT=80
# Nivel mínimo de log: fatal, error, warn, log, debug o verbose.
LOG_LEVEL=log
# Proxies de confianza para conocer la IP del cliente (límites de intentos). Con el Nginx del frontend delante
# de la API, 1 (un salto); sin proxy, false. Admite también rangos CIDR separados por coma. Evita true.
TRUST_PROXY=1
# Secreto con el que se firman los tokens de acceso JWT. Obligatorio: aleatorio, de al menos 32 caracteres (openssl rand -hex 48).
JWT_SECRET=
# Vigencia del token de acceso (30s, 15m, 30m). Máximo 30m.
JWT_EXPIRATION=15m
# Vigencia del refresh token y de su cookie HttpOnly (ventana deslizante; ej. 7d).
REFRESH_TTL=7d
# Duración absoluta máxima de una sesión aunque se rote el refresh token (no menor que REFRESH_TTL; ej. 30d).
REFRESH_MAX_LIFETIME=30d
# Dirección pública HTTPS de la aplicación web para construir enlaces de invitación y recuperación (ej. https://app.iglesia238.com).
APP_BASE_URL=https://app.iglesia238.com
# Código ISO 3166-1 alfa-2 del país por defecto para códigos de municipio sin país explícito (ej. CO, MX, PE).
DEFAULT_COUNTRY_ISO=CO
# Servidor SMTP para envío de correos (invitaciones, verificación de sede y recuperación de contraseña). Dejar vacío si no se usa.
SMTP_HOST=
# Puerto del servidor SMTP (normalmente 587 para STARTTLS o 465 para TLS implícito).
SMTP_PORT=587
# true para TLS implícito (puerto 465); false negocia STARTTLS si el servidor lo ofrece.
SMTP_SECURE=false
# Usuario de autenticación SMTP (debe configurarse junto con SMTP_PASSWORD o dejar ambos vacíos).
SMTP_USER=
# Contraseña de autenticación SMTP.
SMTP_PASSWORD=
# Remitente visible en los correos enviados por la plataforma (obligatorio cuando se define SMTP_HOST).
SMTP_FROM="Iglesia 238 <no-reply@iglesia238.com>"
